[TEMPLATE]
# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication
JWT_SECRET="your-super-secret-jwt-secret"

# Stripe
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# Administration
ADMIN_EMAIL="admin@example.com"

# Email Notifications
SENDGRID_API_KEY="your-sendgrid-api-key"

# Approval Workflow Feature Flag (ISSUE-020)
APPROVAL_WORKFLOW_ENABLED=false

# Soroban RPC (contract event streaming)
SOROBAN_RPC_URL=https://soroban-rpc.stellar.org
STELLARAID_CONTRACT_IDS=
CONTRACT_EVENT_POLLING_INTERVAL_MS=5000
CONTRACT_EVENT_START_LEDGER_OFFSET=100
